<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilo base (modo claro) -->
    <style name="Base.Theme.RioMarAppNav.Light" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/laranja</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>

        <!-- Atributos customizados -->
        <item name="containerColor">@color/container_light_gray</item>
        <item name="cardBackgroundColor">@color/container_light_gray</item>
        <item name="selectorFalseColor">@color/item_selector_light_gray</item>
    </style>

    <!-- Tema claro final, que herda do Base Light -->
    <style name="Theme.RioMarAppNav" parent="Base.Theme.RioMarAppNav.Light">
        <!-- Sobrescreva algo se quiser -->
    </style>

    <!-- Outros estilos que você queira -->
    <style name="BACKGROUND">
        <item name="android:background">@color/background_light_white</item>
    </style>

    <style name="TEXTCOLOR">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TEXTCOLORBIG">
        <item name="android:backgroundTint">@color/laranja</item>
    </style>

    <style name="BUTTON">
        <item name="android:backgroundTint">@color/laranja</item>
    </style>

    <style name="CONTAINER">
        <item name="android:background">@color/container_light_gray</item>
    </style>

    <style name="PERMISSION_COLOR">
        <item name="android:background">@color/container_light_gray</item>
    </style>



</resources>
